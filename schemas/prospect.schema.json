{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathovai.com/schemas/prospect.schema.json",
  "title": "Pipeline Input: Prospect",
  "description": "Raw research inputs for the gap-prospecting pipeline. Stage 1 (PIC) consumes this, promotes research_signals into structured evidence, and diagnoses the gap.",
  "type": "object",
  "required": ["account", "persona", "research_signals", "channel", "sender"],
  "additionalProperties": false,
  "properties": {
    "account": {
      "type": "object",
      "required": ["name", "segment"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "segment": { "type": "string" },
        "size": { "type": "string" }
      }
    },
    "persona": {
      "type": "object",
      "required": ["title", "role_family", "seniority"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "role_family": {
          "type": "string",
          "enum": ["clinical", "commercial", "market_access", "operations", "finance", "it", "executive"]
        },
        "seniority": {
          "type": "string",
          "enum": ["ic", "manager", "director", "vp", "c_suite"]
        }
      }
    },
    "research_signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "source", "date"],
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "source": { "type": "string" },
          "date": { "type": "string", "format": "date" }
        }
      }
    },
    "channel": {
      "type": "string",
      "enum": ["email", "linkedin", "phone"]
    },
    "sender": {
      "type": "object",
      "required": ["name", "title", "company"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "company": { "type": "string" }
      }
    }
  }
}
