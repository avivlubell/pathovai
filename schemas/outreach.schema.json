{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathovai.com/schemas/outreach.schema.json",
  "title": "Outreach Draft",
  "type": "object",
  "required": ["channel", "body", "cta", "references"],
  "additionalProperties": false,
  "properties": {
    "channel": { "type": "string", "enum": ["email", "linkedin", "phone"] },
    "subject": {
      "type": ["string", "null"],
      "description": "Required for email (<= 8 words). Must be null for linkedin and phone."
    },
    "body": { "type": "string", "minLength": 1 },
    "cta": { "type": "string", "minLength": 1 },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pic_section", "evidence_id"],
        "additionalProperties": false,
        "properties": {
          "pic_section": {
            "type": "string",
            "enum": ["problem_diagnosis", "hypothesis", "qualification"]
          },
          "evidence_id": { "type": "string", "pattern": "^E[0-9]+$" }
        }
      }
    },
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "company": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "channel": { "const": "email" } } },
      "then": { "required": ["subject"], "properties": { "subject": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": { "properties": { "channel": { "enum": ["linkedin", "phone"] } } },
      "then": { "properties": { "subject": { "type": "null" } } }
    }
  ]
}
